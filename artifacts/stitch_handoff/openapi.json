          },
          "league_average": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "League Average"
          },
          "sample_games": {
            "type": "integer",
            "title": "Sample Games",
            "default": 0
          },
          "sample_possessions": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sample Possessions"
          },
          "reliability": {
            "type": "string",
            "enum": [
              "high",
              "moderate",
              "low"
            ],
            "title": "Reliability",
            "default": "moderate"
          },
          "validation_state": {
            "type": "string",
            "title": "Validation State",
            "default": "validated_deterministic"
          },
          "direction": {
            "type": "string",
            "title": "Direction",
            "default": "neutral"
          },
          "win_loss": {
            "$ref": "#/components/schemas/WinLossCard"
          },
          "limitations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Limitations"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "evidence_id",
          "metric",
          "scope",
          "value"
        ],
        "title": "EvidenceCard",
        "description": "One deterministic fact, pre-formatted for display.\n\nEvery value here is a *string the backend already formatted*. A frontend must\nnever recompute or reformat these — that is the boundary that keeps the\nauthoritative numbers deterministic."
      },
      "GenerateRequest": {
        "properties": {
          "team_id": {
            "type": "string",
            "maxLength": 40,
            "minLength": 1,
            "title": "Team Id"
          },
          "force_regenerate": {
            "type": "boolean",
            "title": "Force Regenerate",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "team_id"
        ],
        "title": "GenerateRequest",
        "description": "The complete admin generation input.\n\n``extra=\"forbid\"`` is load-bearing: it is what makes \"no arbitrary free-text\nreaches a prompt\" checkable rather than merely intended."
      },
      "GenerateResponse": {
        "properties": {
