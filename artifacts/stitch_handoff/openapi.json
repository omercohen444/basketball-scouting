        }
      }
    },
    "/api/admin/reports/generate": {
      "post": {
        "tags": [
          "api"
        ],
        "summary": "Generate, validate and save a report (admin only)",
        "description": "The only endpoint that can spend a provider call.\n\nDeclared ``def`` (not ``async def``) on purpose: FastAPI runs it in the\nthreadpool, so a generation that takes a minute does not block the event loop\nfor everybody reading saved reports.",
        "operationId": "generate_report_api_admin_reports_generate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenerateResponse"
                }
              }
