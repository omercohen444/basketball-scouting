            "type": "integer",
            "title": "Duration Ms",
            "default": 0
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          },
          "rejects": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Rejects"
          },
          "detail": {
            "anyOf": [
