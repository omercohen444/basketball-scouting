              }
            }
          }
        }
      }
    },
    "/api/reports/{report_id}/pdf": {
      "get": {
        "tags": [
          "api"
        ],
        "summary": "PDF of a saved report",
        "description": "Rendered from the stored report. Never calls the provider.",
        "operationId": "get_report_pdf_api_reports__report_id__pdf_get",
        "parameters": [
          {
            "name": "report_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Report Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "PDF document",
            "content": {
              "application/pdf": {}
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
