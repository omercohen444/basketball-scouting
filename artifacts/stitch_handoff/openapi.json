          "text"
        ],
        "title": "ClaimView",
        "description": "One statement in a report section, with the evidence it rests on."
      },
      "EvidenceCard": {
        "properties": {
          "evidence_id": {
            "type": "string",
            "title": "Evidence Id"
          },
          "metric": {
            "type": "string",
            "title": "Metric"
          },
          "scope": {
