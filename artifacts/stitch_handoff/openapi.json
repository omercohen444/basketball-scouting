{
  "openapi": "3.1.0",
  "info": {
    "title": "Basketball Analytics and AI Scouting System",
    "description": "Opponent scouting for the Israeli Basketball Premier League.\n\nDeterministic play-by-play analytics compute every number; a constrained\nthree-agent pipeline selects, interprets and prioritizes that evidence and writes\nno numbers of its own. Public routes only ever read reports that were already\ngenerated, validated and saved.",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Liveness and configuration snapshot",
        "description": "Never touches the database or the provider — it must stay cheap enough\nfor a platform health check to hit it constantly.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/teams": {
      "get": {
        "tags": [
          "api"
        ],
        "summary": "List the supported opponents",
        "operationId": "list_teams_api_teams_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TeamsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/reports/latest/{team_id}": {
      "get": {
        "tags": [
          "api"
        ],
        "summary": "Latest saved report for one team",
        "operationId": "latest_report_api_reports_latest__team_id__get",
        "parameters": [
          {
            "name": "team_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Team Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicReport"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/reports/{report_id}": {
      "get": {
        "tags": [
          "api"
        ],
        "summary": "One saved report by id",
        "operationId": "get_report_api_reports__report_id__get",
