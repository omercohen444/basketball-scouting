# Copy to `.env` and fill in real values. NEVER commit `.env`.
# `.env` is git-ignored; `.env.example` must stay free of real credentials.
#
# Nothing here is required to run the test suite — the whole offline suite
# passes with no credentials and no network. Missing values fail at the point of
# use with an actionable message, never at import.

# ============================================================================
#  Product (FastAPI + Supabase + PDF)
# ============================================================================

# ---- Supabase persistence ----
# Both forms of the project URL are accepted:
#   https://<ref>.supabase.co        (origin)
#   https://<ref>.supabase.co/rest/v1 (REST base)
SUPABASE_URL=
# The SERVER secret key (sb_secret_... or the legacy service_role JWT).
# Backend only — never ship this to a browser. SUPABASE_KEY is accepted as a
# legacy alias for the same value.
SUPABASE_SECRET_KEY=

# When either Supabase value is missing the app falls back to in-memory storage
# and logs a warning. It still boots and serves; saved reports are lost on
# restart.

# ---- Admin ----
# Required by POST /api/admin/reports/generate, compared with a constant-time
# check against the X-Admin-Token header. Unset means generation is DISABLED
# (503), never open. Use a long random value:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
REPORT_ADMIN_TOKEN=

# ---- Serving ----
# PORT is supplied by the platform (Railway). HOST defaults to 0.0.0.0.
# PORT=8000
# HOST=0.0.0.0
# LOG_LEVEL=INFO

# ---- Rate limiting (in-process, per client address) ----
# 0 disables a limiter.
# API_RATE_LIMIT_PER_MINUTE=120
# ADMIN_RATE_LIMIT_PER_HOUR=12

# ============================================================================
#  Agents / provider
# ============================================================================

# ---- Gemini ----
GEMINI_API_KEY=

# Model used by the three-agent scouting pipeline.
# gemini-3.5-flash is the verified pin. gemini-2.5-flash is listed by the API
# but returns HTTP 404 "no longer available to new users" (CP1-C, 2026-08-15) —
# do not "fix" a failure by falling back to it.
AGENT_MODEL=gemini-3.5-flash

# ============================================================================
#  Video spike (prototyped, evaluated, and excluded from the MVP)
# ============================================================================
# Retained because the spike harnesses are still runnable; nothing in the
# product reads these.

GEMINI_VIDEO_MODEL=gemini-3.5-flash
# Frames-per-second sampled from the video window. Blank = API default.
GEMINI_VIDEO_FPS=
# LOW | MEDIUM | HIGH — media resolution hint. Blank = API default.
GEMINI_MEDIA_RESOLUTION=

# ---- Spike HTTP probe ----
SEGEVSPORT_PROBE_URL=
HTTP_TIMEOUT_SECONDS=20

# ============================================================================
#  Local paths (relative to repo root unless absolute)
# ============================================================================
DATA_DIR=data
ARTIFACTS_DIR=artifacts
