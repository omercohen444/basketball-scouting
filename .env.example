# Copy to `.env` and fill in real values. NEVER commit `.env`.
# `.env` is git-ignored; `.env.example` must stay free of real credentials.

# ---- Gemini (video analytics spike) ----
GEMINI_API_KEY=

# Model used for multimodal video classification.
# Verified and pinned during CP1-C (2026-08-15, docs/VIDEO_STAGE_PLAN.md).
# gemini-2.5-flash was tried first and returned HTTP 404 "no longer available
# to new users" despite being listed by --list-models — re-verify with
# `python scripts/spikes/gemini_video_event.py --list-models` before relying
# on this default if pinning a different model later.
GEMINI_VIDEO_MODEL=gemini-3.5-flash

# Frames-per-second sampled from the video window. Lower = cheaper/faster.
# Leave blank to use the API default.
GEMINI_VIDEO_FPS=

# LOW | MEDIUM | HIGH — media resolution hint. Blank = API default.
GEMINI_MEDIA_RESOLUTION=

# ---- Spike HTTP probe ----
# Default source page for the PBP probe harness. Always overridable with --url.
SEGEVSPORT_PROBE_URL=

# Seconds before an HTTP probe request gives up.
HTTP_TIMEOUT_SECONDS=20

# ---- Local paths (relative to repo root unless absolute) ----
DATA_DIR=data
ARTIFACTS_DIR=artifacts

# ---- Not used yet: reserved for later build stages ----
# Populated only when the Supabase / persistence stage begins.
SUPABASE_URL=
SUPABASE_KEY=
